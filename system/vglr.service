[Unit]
Description=vglr audio-reactive video glitch player
# Start after the sound subsystem and local filesystems are ready.
# Does not require a display server — uses KMS/DRM directly.
After=sound.target local-fs.target

[Service]
User=YOUR_USERNAME
Group=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/vglr

# SDL2 must use KMS/DRM since there is no Wayland/X display.
Environment=SDL_VIDEODRIVER=kmsdrm

ExecStart=/home/YOUR_USERNAME/vglr/venv/bin/python vglr.py --window sdl2 --fullscreen

# Restart automatically if the process exits unexpectedly (e.g. shader error).
Restart=on-failure
RestartSec=5

# Capture stdout/stderr to the journal (view with: journalctl -u vglr -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
